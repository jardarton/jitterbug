# demo_sources: the sources are what the generator writes.
#   cmake -DWORK=<scratch directory> -DSOURCES=<assets/sources>
#         -P sources.cmake -- [EMULATOR...] <demo-make-sources>
# runs the generator into WORK and requires the same files as SOURCES, each
# byte for byte. (After a deliberate change, the demo_assets_regen target
# writes them again, and the files made from them; examples/demo/README.md,
# "How the assets are made".)
cmake_minimum_required(VERSION 3.24)

set(_cmd)
set(_on 0)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_i RANGE ${_last})
  if(_on)
    list(APPEND _cmd "${CMAKE_ARGV${_i}}")
  elseif("${CMAKE_ARGV${_i}}" STREQUAL "--")
    set(_on 1)
  endif()
endforeach()
if(NOT _cmd OR NOT WORK OR NOT SOURCES)
  message(FATAL_ERROR "sources.cmake: -DWORK, -DSOURCES and the generator after -- are required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
execute_process(COMMAND ${_cmd} "${WORK}" RESULT_VARIABLE _rc OUTPUT_VARIABLE _o ERROR_VARIABLE _o)
if(NOT _rc EQUAL 0)
  message(FATAL_ERROR "sources.cmake: the generator returned ${_rc}: ${_o}")
endif()
file(GLOB _made RELATIVE "${WORK}" "${WORK}/*")
file(GLOB _kept RELATIVE "${SOURCES}" "${SOURCES}/*")
list(SORT _made)
list(SORT _kept)
if(NOT _made STREQUAL _kept)
  message(FATAL_ERROR "sources.cmake: the generator writes ${_made}, sources/ holds ${_kept}")
endif()
set(failures 0)
foreach(_f IN LISTS _made)
  execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${WORK}/${_f}" "${SOURCES}/${_f}"
                  RESULT_VARIABLE _same)
  if(NOT _same EQUAL 0)
    message("FAIL ${_f}: not what the generator writes")
    math(EXPR failures "${failures} + 1")
  endif()
endforeach()
list(LENGTH _made _n)
if(failures GREATER 0)
  message(FATAL_ERROR "${failures} of ${_n} sources differ")
endif()
message("demo_sources: all ${_n} files are what the generator writes")
