+jbi_audit_px *jbi_audit_map;
+const uint16_t *jbi_audit_vram;
+uint32_t jbi_audit_id;
+
+#define AUDIT_ON(vram) (jbi_audit_map != NULL && (const uint16_t *)(vram) == jbi_audit_vram)
+#define AUDIT_FLAGS(mode, set_mask, raw, dither, check_mask, shaded, semi)                     \
+    (((mode) & 3) | ((set_mask) ? JBI_AUDIT_SET_MASK : 0) | ((raw) ? JBI_AUDIT_RAW : 0) |      \
+     ((dither) ? JBI_AUDIT_DITHER : 0) | ((check_mask) ? JBI_AUDIT_CHECK_MASK : 0) |           \
+     ((shaded) ? JBI_AUDIT_SHADED : 0) | ((semi) ? JBI_AUDIT_SEMI : 0))
+/* One event at pixel dst: bg is the pixel before, *dst after. */
+static inline void audit_ev(const uint16_t *vram, const uint16_t *dst, int kind, uint32_t bg,
+                            uint32_t src, uint32_t texel, int u, int v, int flags, int r, int g,
+                            int b)
+{
+    if (AUDIT_ON(vram)) {
+        jbi_audit_px *a = &jbi_audit_map[dst - vram];
+        jbi_audit_ev *e = &a->ev[a->n++ % JBI_AUDIT_HIST];
+
+        e->id = jbi_audit_id;
+        e->bg = (uint16_t)bg;
+        e->out = *dst;
+        e->src = (uint16_t)src;
+        e->texel = (uint16_t)texel;
+        e->u = (int16_t)u;
+        e->v = (int16_t)v;
+        e->r = (int16_t)r;
+        e->g = (int16_t)g;
+        e->b = (int16_t)b;
+        e->kind = (uint8_t)kind;
+        e->flags = (uint8_t)flags;
+    }
+}
