diff -ruN a/src/soft/audit.h b/src/soft/audit.h
--- a/src/soft/audit.h
+++ b/src/soft/audit.h
@@ -0,0 +1,59 @@
+/*
+ * Audit instrumentation (tools/seed-record/audit, not part of jitterbug):
+ * for every pixel of the 1x VRAM, the last JBI_AUDIT_HIST times a
+ * triangle, rectangle or line wrote it or passed over it without writing,
+ * oldest first, with what went into each write. Recorded only while
+ * jbi_audit_map is set and only for the VRAM jbi_audit_vram points to;
+ * single-threaded use only (--threads 1). Fills, copies, uploads, pokes and
+ * the 1x pixels filled in from the scaled VRAM are not recorded: they show
+ * as a pixel whose value is not what the last recorded event left.
+ */
+#ifndef JB_SOFT_AUDIT_H
+#define JB_SOFT_AUDIT_H
+
+#include <stdint.h>
+
+enum {
+    JBI_AUDIT_FLAT = 1,     /* untextured flat triangle */
+    JBI_AUDIT_GOURAUD = 2,  /* untextured Gouraud triangle */
+    JBI_AUDIT_TEXTURED = 3, /* textured triangle */
+    JBI_AUDIT_TILE = 4,     /* untextured rectangle */
+    JBI_AUDIT_SPRITE = 5,   /* textured rectangle */
+    JBI_AUDIT_LINE = 6,
+    JBI_AUDIT_BLENDED = 0x10,          /* or-ed in: semi-transparency applied */
+    JBI_AUDIT_SKIP_TRANSPARENT = 0x20, /* or-ed in: not written, texel 0x0000 */
+    JBI_AUDIT_SKIP_MASK = 0x40,        /* or-ed in: not written, the mask bit (check_mask) */
+    /* flags: bits 0-1 the semi-transparency mode, and the primitive's state */
+    JBI_AUDIT_SET_MASK = 4,     /* set_mask */
+    JBI_AUDIT_RAW = 8,          /* textured: raw (the texel not modulated) */
+    JBI_AUDIT_DITHER = 0x10,    /* dithered */
+    JBI_AUDIT_CHECK_MASK = 0x20, /* check_mask */
+    JBI_AUDIT_SHADED = 0x40,    /* the colour interpolated (Gouraud) */
+    JBI_AUDIT_SEMI = 0x80,      /* semi-transparent primitive */
+    JBI_AUDIT_HIST = 16
+};
+
+typedef struct {
+    uint32_t id;    /* the primitive, from 1 in drawing order */
+    uint16_t bg;    /* the pixel before */
+    uint16_t out;   /* the pixel after (bg for a skip) */
+    uint16_t src;   /* writes: the colour before blending, 5 bits a channel */
+    uint16_t texel; /* textured: the texel (0 for a transparent skip) */
+    int16_t u, v;   /* textured: the texel coordinate sampled */
+    int16_t r, g, b; /* writes: the colour before texturing and dithering, 8 bits a
+                        channel (interpolated or the primitive's; a raw
+                        texture's ignores it); 0 for a skip */
+    uint8_t kind;   /* JBI_AUDIT_* */
+    uint8_t flags;  /* the semi-transparency mode and the state bits above */
+} jbi_audit_ev;
+
+typedef struct {
+    uint32_t n; /* events so far; event k is ev[k % JBI_AUDIT_HIST] */
+    jbi_audit_ev ev[JBI_AUDIT_HIST];
+} jbi_audit_px;
+
+extern jbi_audit_px *jbi_audit_map;
+extern const uint16_t *jbi_audit_vram;
+extern uint32_t jbi_audit_id;
+
+#endif
