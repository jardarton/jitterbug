+/* JB_AUDIT (tools/seed-record/audit): at a capture, the map entries of
+   every 1x pixel that differs from the other build's dump of the same
+   capture (JB_AUDIT_OTHER), as NAME.opK.audit: "JBAUDIT3", the number of
+   entries and the size of one (uint32 each), then for each the pixel's
+   index (uint32) and its jbi_audit_px, in increasing index order. */
+static void audit_write(const Scene *s, const uint16_t *pix, size_t count)
+{
+    static uint16_t *other;
+    char path[4096];
+    FILE *f;
+    size_t i;
+    uint32_t n = 0, size = (uint32_t)sizeof(jbi_audit_px);
+
+    if (other == NULL && (other = malloc(count * 2)) == NULL) {
+        fprintf(stderr, "seed_replay: JB_AUDIT: out of memory\n");
+        exit(2);
+    }
+    snprintf(path, sizeof path, "%s/%s.op%u.1x.raw", getenv("JB_AUDIT_OTHER"), s->name, s->op);
+    f = fopen(path, "rb");
+    if (f == NULL || fread(other, 2, count, f) != count || fgetc(f) != EOF) {
+        fprintf(stderr, "seed_replay: JB_AUDIT: cannot read %s\n", path);
+        exit(2);
+    }
+    fclose(f);
+    for (i = 0; i < count; ++i)
+        n += pix[i] != other[i];
+    snprintf(path, sizeof path, "%s/%s.op%u.audit", bl.dump, s->name, s->op);
+    f = fopen(path, "wb");
+    if (f == NULL || fwrite("JBAUDIT3", 1, 8, f) != 8 || fwrite(&n, 4, 1, f) != 1 ||
+        fwrite(&size, 4, 1, f) != 1) {
+        fprintf(stderr, "seed_replay: cannot write %s\n", path);
+        exit(2);
+    }
+    for (i = 0; i < count; ++i) {
+        uint32_t index = (uint32_t)i;
+
+        if (pix[i] == other[i])
+            continue;
+        if (fwrite(&index, 4, 1, f) != 1 || fwrite(&jbi_audit_map[i], size, 1, f) != 1) {
+            fprintf(stderr, "seed_replay: cannot write %s\n", path);
+            exit(2);
+        }
+    }
+    if (fclose(f) != 0) {
+        fprintf(stderr, "seed_replay: cannot write %s\n", path);
+        exit(2);
+    }
+}
